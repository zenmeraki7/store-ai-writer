# Default: fully local, no keys, no limits.
PROVIDER_ORDER=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=gemma3:4b

# Optional, for quality comparison only (free NVIDIA key, ~40 requests/min limit).
# To use: PROVIDER_ORDER=nvidia,ollama
NVIDIA_API_KEY=
NVIDIA_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_RPM=35
